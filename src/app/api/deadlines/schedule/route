import { NextResponse } from "next/server";
import { createClient } from "@/lib/supabase/server";

export const dynamic = "force-dynamic";

export async function GET() {
  const supabase = await createClient();
  const { data } = await supabase.from("class_schedule")
    .select("id, day, start_time, end_time, course, room")
    .order("day").order("start_time");
  return NextResponse.json(
    (data ?? []).map((r) => ({
      id: r.id, day: r.day,
      start: String(r.start_time).slice(0, 5), end: String(r.end_time).slice(0, 5),
      course: r.course, room: r.room ?? "", source: "angkatan",
    }))
  );
}